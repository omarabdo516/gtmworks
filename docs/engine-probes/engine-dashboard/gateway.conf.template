# The install's gateway (nginx, the image docker-compose.install.yml pins) with one probe location in front of a
# Company's Engine dashboard, for Probe B of spec #822 (#826). run.sh fills the three @…@ values. The browser never
# talks to the Engine: every request, WebSocket upgrades included, is asked about first (auth_request), the Engine's
# key is added here and never sent to the browser, and the gtmworks session cookie is not passed on to the Engine.
map $http_upgrade $connection_upgrade { default upgrade; '' close; }
server {
    listen 8080;
    # The answer a missing page gets (ADR 0004), the same for a path nobody may open and for one that does not exist.
    location @missing { default_type text/html; return 404 '<!doctype html><title>Not found</title><h1>This page could not be found.</h1>\n'; }
    location / { error_page 404 = @missing; return 404; }

    location = /_gate {
        internal;
        proxy_pass http://@GATE@/check;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header X-Upgrade $http_upgrade;
        proxy_set_header X-Referer $http_referer;
        proxy_set_header Cookie $http_cookie;
    }

    # The dashboard's lazily loaded pages ask for their code at the root (/assets/…, the bundle's own base), not under
    # the prefix the first page was served at. They are let through for the same Owner the page they were asked from
    # (Referer) is open to.
    location /assets/ {
        auth_request /_gate;
        error_page 401 403 = @missing;
        proxy_set_header Host @ENGINE_HOST@;
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_pass http://@ENGINE_HOST@/assets/;
    }

    location /engine/rs-learning/ {
        auth_request /_gate;
        error_page 401 403 = @missing;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        # The dashboard's DNS-rebinding and Origin guards trust the address it is published at
        # (HERMES_DASHBOARD_PUBLIC_URL), so the request reaches it as if from there.
        proxy_set_header Host @ENGINE_HOST@;
        proxy_set_header Origin http://@ENGINE_HOST@;
        proxy_set_header X-Forwarded-Prefix /engine/rs-learning;
        proxy_set_header Authorization "Bearer @ENGINE_KEY@";
        proxy_set_header Cookie "";
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_pass http://@ENGINE_HOST@/;
    }
}
