{
  "name": "gtmworks",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "bash scripts/local-db.sh && bash scripts/web.sh",
    "dev:web": "bash scripts/web.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint components app lib scripts tests middleware.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'tests/**/*.test.mjs'",
    "test:db": "bash tests/db.sh",
    "test:e2e": "playwright test",
    "test:e2e:proxy": "playwright test -c playwright.proxy.config.ts",
    "test:visual": "playwright test --project=visual --no-deps",
    "test:visual:update": "playwright test --project=visual --no-deps --update-snapshots=changed",
    "worker": "node worker/index.mjs",
    "design:compare": "node scripts/design-compare.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "*",
    "@supabase/supabase-js": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "next": "^15.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@playwright/test": "*",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "*",
    "@types/react": "*",
    "@types/react-dom": "*",
    "eslint": "*",
    "eslint-config-next": "*",
    "js-yaml": "^5.5.0",
    "supabase": "*",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
