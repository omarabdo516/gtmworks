# Supabase project API URL.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase anonymous public key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase service role key used by the app and the worker. The app signs no token, so it needs no JWT secret.
SUPABASE_SERVICE_ROLE_KEY=
# Base64-encoded 32-byte key for webhook secret encryption.
WEBHOOK_ENCRYPTION_KEY=
# Public HTTPS origin used in webhook links.
APP_ORIGIN=
