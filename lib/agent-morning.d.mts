import type { RoutineSchedule } from './engine.mjs';
export const morningName: string;
export const morningPrompt: string;
export const morningTimes: string[];
export const morningDefault: string;
export const morningLevel: number;
export type MorningRoutine = { id: string, on: boolean, time: string | null, schedule: RoutineSchedule, timezone: string | null };
export type MorningRead = { state: 'found', level: number, allowed: boolean, routine: MorningRoutine | null, quietYesterday: boolean } | { state: 'invalid' | 'failed' | 'notMain' | 'notOwn' | 'noEngine' | 'refused' | 'unreachable' };
export function morningTime(routine: { schedule: { expr: string | null } }): string | null;
export function morningCron(time: unknown): string | null;
export function findMorning(routines: import('./engine.mjs').Routine[]): import('./engine.mjs').Routine | null;
export function readAgentMorning(db: any, request: { company: string, agent: string, hermes?: any, driver?: object, now?: Date }): Promise<MorningRead>;
export function changeAgentMorning(db: any, request: { company: string, agent: unknown, on: unknown, time: unknown, zone?: unknown, hermes?: any, driver?: object }): Promise<{ state: 'written', morning: { on: boolean, time: string } } | { state: string, morning?: undefined }>;
export function moveAgentMorning(db: any, request: { company: string, from: string, to: string, hermes?: any, driver?: object }): Promise<{ state: string }>;
