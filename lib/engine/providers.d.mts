export type SignInProvider='openai-codex'|'anthropic';
export const signInProviders:SignInProvider[];
export type SignIns=Record<SignInProvider,{connected:boolean,root:boolean,flow:'device_code'|'external'}>;
export function readSignIns(connection:import('../engine.mjs').EngineConnection):Promise<{state:'found'|'refused'|'unreachable'|'failed',signIns:SignIns|null}>;
export function startSignIn(connection:import('../engine.mjs').EngineConnection,provider:string):Promise<{state:'started'|'terminal_only'|'refused'|'unreachable'|'failed',session:string|null,code:string|null,link:string|null,expiresIn:number|null,interval:number|null}>;
export function pollSignIn(connection:import('../engine.mjs').EngineConnection,provider:string,session:string):Promise<{state:'pending'|'approved'|'denied'|'expired'|'error'|'cancelled'|'refused'|'unreachable'|'failed'}>;
export function cancelSignIn(connection:import('../engine.mjs').EngineConnection,session:string):Promise<{state:'cancelled'|'refused'|'unreachable'|'failed'}>;
export function disconnectSignIn(connection:import('../engine.mjs').EngineConnection,provider:string):Promise<{state:'disconnected'|'nothing'|'refused'|'unreachable'|'failed'}>;
export function readSubscriptionAccounts(connection:import('../engine.mjs').EngineConnection):Promise<{state:'found'|'refused'|'unreachable'|'failed',accounts:{provider:SignInProvider,account:string,exhausted:boolean}[]|null}>;
export function removeSubscriptionAccount(connection:import('../engine.mjs').EngineConnection,provider:string,account:string):Promise<{state:'disconnected'|'nothing'|'refused'|'unreachable'|'failed'}>;
export function writeAccountOrder(connection:import('../engine.mjs').EngineConnection,provider:string,entries:{account:string,off:boolean}[]):Promise<{state:'written'|'unsupported'|'refused'|'unreachable'|'failed'}>;
export type AccountSwitch={id:string,provider:SignInProvider,from:string,to:string,at:number};
export function readAccountSwitches(connection:import('../engine.mjs').EngineConnection):Promise<{state:'found',switches:AccountSwitch[]}|{state:'unsupported'|'refused'|'unreachable'|'failed',switches:null}>;
export type ProviderKey={provider:string,label:string,set:boolean};
export function readProviderKeys(connection:import('../engine.mjs').EngineConnection,target:{space:string,profiles:string[]}):Promise<{state:'found',keys:ProviderKey[],lacking:string[],leftover:string[],unread:string[]}|{state:'refused'|'unreachable'|'failed',keys:null,lacking:null,leftover:null,unread:null}>;
export function readHeldKeys(connection:import('../engine.mjs').EngineConnection,target:{space:string,profiles:string[]}):Promise<{state:'found',held:Record<string,string[]>,unread:string[]}|{state:'refused'|'unreachable'|'failed',held:null,unread:null}>;
export type ProfileKeyState='written'|'noModel'|'modelUnread'|'refused'|'unreachable'|'failed';
export function setProviderKey(connection:import('../engine.mjs').EngineConnection,key:{space:string,profiles:string[],provider:string,value:string,profilesOnly?:boolean}):Promise<{state:'written',model:string|null,profiles:Record<string,ProfileKeyState>}|{state:'unknownProvider'|'invalid'|'refused'|'unreachable'|'failed',model:null,profiles:null}>;
export type ProfileKeyRemoval='removed'|'nothing'|'refused'|'unreachable'|'failed';
export function removeProviderKey(connection:import('../engine.mjs').EngineConnection,key:{space:string,profiles:string[],provider:string}):Promise<{state:'removed'|'nothing',profiles:Record<string,ProfileKeyRemoval>}|{state:'unknownProvider'|'refused'|'unreachable'|'failed',profiles:null}>;
